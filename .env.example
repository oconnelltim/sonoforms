# SonoForms settings for docker-compose. ./install.sh creates .env from this.

# The name users type in the browser, e.g. sonoforms.hospital.local
SERVER_NAME=localhost
HTTPS_PORT=443
HTTP_PORT=80

# Time zone for timestamps and the nightly backup (e.g. America/New_York)
TZ=UTC

# Nightly backup hour (0-23) and how many backups to keep in ./backups
BACKUP_HOUR=2
BACKUP_KEEP=14

# true = show fake demo studies instead of querying PACS (for trying it out)
DICOM_MOCK=false

# Set by install.sh so files in ./backups belong to you
APP_UID=1000
APP_GID=1000

# Private address range for the internal web<->app network. Only change it
# if it clashes with an address range used on your hospital network.
PROXY_SUBNET=172.31.250.0/28

# Only if a hospital reverse proxy (F5, NetScaler, NGINX…) sits in front of
# SonoForms: its IP address(es) or range, separated by spaces. Apache then
# records the user's real address from that proxy's X-Forwarded-For header
# (for the audit log and sign-in throttling) and ignores it from anyone
# else. Leave empty when users connect to this server directly.
UPSTREAM_PROXY=
