{
  "name": "sonoforms",
  "version": "0.3.1",
  "description": "Structured ultrasound technologist worksheets that generate radiologist-ready findings text. Self-hosted, offline, no AI.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node scripts/dev.js",
    "dev:cli": "node scripts/dev-cli.js",
    "mock-pacs": "node scripts/mock-pacs.js",
    "test": "node --test test/*.test.js",
    "check": "npm test && npm run lint-forms && npm audit --omit=dev --audit-level=high",
    "check:linux": "bash scripts/check-linux.sh",
    "security": "bash scripts/security-scan.sh",
    "lint-forms": "node server/cli.js lint-forms"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.7",
    "dcmjs-dimse": "^0.3.4",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "dcmjs": "^0.52.2"
  }
}
